NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only Supabase credentials for scraper writes.
SCRAPER_SUPABASE_URL=
SCRAPER_SUPABASE_KEY=

# Browser map key, restricted to the site's domains and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server/scraper key, restricted to Geocoding API.
# Set this in the deployment environment and the GitHub Actions secret of the same name.
GOOGLE_MAPS_API_KEY=
